# ==============================================================================
# WARGATIVE STUDIO - ENVIRONMENT TEMPLATE
# Salin file ini menjadi .env.local untuk development lokal
# ==============================================================================

# CE.SDK License Key (Trial / Production)
VITE_CESDK_LICENSE=YOUR_LICENSE_KEY_HERE
VITE_DEMO_ASSETS_BASE_URL=https://staticimgly.com/imgly/cesdk-web-examples-data/1.83.0/starterkit-design-editor

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Phase 1: Multi-User Auth - Client-Side Vite SPA)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# ------------------------------------------------------------------------------
# 2. BACKEND SERVERLESS CONFIGURATION (Phase 2: Node.js Serverless Functions)
# Masukkan nilai ini ke Vercel Dashboard -> Settings -> Environment Variables.
# JANGAN gunakan prefix VITE_ agar TIDAK PERNAH bocor ke bundel browser!
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# Kunci Enkripsi Kredensial AES-256 (32 bytes / 64 hex characters)
# Nilai ini harus disimpan secara permanen & konsisten di Vercel Dashboard
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. META OAUTH CONFIGURATION (Phase 3: Facebook & Instagram Integration)
# Dapatkan dari Meta for Developers (developers.facebook.com) -> App Dashboard
# Masukkan nilai ini ke Vercel Dashboard -> Settings -> Environment Variables
# ------------------------------------------------------------------------------
META_APP_ID=1074079788556384
META_APP_SECRET=YOUR_META_APP_SECRET_HERE
META_REDIRECT_URI=https://wargative-editor.vercel.app/api/auth/meta/callback
